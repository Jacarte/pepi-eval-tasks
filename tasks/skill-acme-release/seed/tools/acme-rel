#!/usr/bin/env bash
# acme-rel: release gateway stub. Appends one release step name to the repo's step log.
set -euo pipefail

if [ "$#" -ne 2 ] || [ "$1" != step ] || [[ ! "$2" =~ ^[a-z]+$ ]]; then
  echo "acme-rel: error E64: invalid invocation" >&2
  exit 64
fi

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
mkdir -p "$root/.acme-rel"
printf '%s\n' "$2" >> "$root/.acme-rel/steps"
echo "acme-rel: recorded $2"
