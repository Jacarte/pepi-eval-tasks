# sandbox settings; keys missing here come from ../../base.yaml
environment: sandbox
replicas: 3
log_level: warn
queue:
  name: quail-sandbox
  batch_size: 300
  visibility_timeout_s: 90
storage:
  include: ../../storage/standard.yaml
http:
  timeout_ms: 2500
upstreams:
  - gateway
  - billing-worker
