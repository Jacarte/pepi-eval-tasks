# sandbox settings; keys missing here come from ../../base.yaml
environment: sandbox
region: ap-south-1
replicas: 1
log_level: info
queue:
  name: quail-sandbox
  batch_size: 200
  visibility_timeout_s: 90
storage:
  include: ../../storage/burst.yaml
http:
  timeout_ms: 1500
upstreams:
  - catalog-api
