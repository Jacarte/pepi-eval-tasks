# staging settings; keys missing here come from ../../base.yaml
environment: staging
region: eu-west-1
replicas: 4
log_level: debug
queue:
  name: heron-staging
  batch_size: 100
  visibility_timeout_s: 120
storage:
  include: ../../storage/legacy.yaml
http:
  timeout_ms: 1500
upstreams:
  - reports-worker
